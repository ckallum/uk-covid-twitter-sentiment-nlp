{
  "functions": {
    "api/*.py": {
      "excludeFiles": "{data/**,static/**,assets/**,venv/**,*.png,*.jpg,*.pdf,README.md,CONTRIBUTING.md,minimal.py,minimal2.py,app.py,serve.py,robust_api.py,wsgi.py,Procfile,runtime.txt}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
} 